{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/autobot.2026-10.json",
  "title": "Autobot Script",
  "type": "object",
  "required": ["autobot", "attach", "script"],
  "additionalProperties": false,
  "properties": {
    "autobot": { "const": "2026-10" },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "vars": {
      "type": "object",
      "additionalProperties": true
    },
    "prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/prompt" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fn": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/function" }
    },
    "attach": { "$ref": "#/$defs/attach" },
    "script": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "prompt": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["send"],
            "properties": { "send": { "type": "object", "required": ["fields"] } }
          },
          "then": { "not": { "required": ["expect"] } },
          "else": { "required": ["expect"] }
        },
        {
          "if": {
            "required": ["return"],
            "properties": { "return": { "const": true } }
          },
          "then": { "not": { "required": ["send"] } }
        }
      ],
      "properties": {
        "name": { "type": "string" },
        "expect": { "$ref": "#/$defs/regexes" },
        "return": { "type": "boolean", "default": false },
        "send": {
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/$defs/sendEach" }
          ]
        }
      }
    },
    "function": {
      "type": "object",
      "required": ["script"],
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "attach": {
      "type": "object",
      "required": ["spawn"],
      "additionalProperties": false,
      "properties": {
        "prepare": { "type": "string" },
        "spawn": { "type": "string" },
        "timeout": { "$ref": "#/$defs/duration" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "script": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        },
        "breakout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "script": {
              "type": "array",
              "items": { "$ref": "#/$defs/step" }
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/cmdStep" },
        { "$ref": "#/$defs/sleepStep" },
        { "$ref": "#/$defs/callStep" },
        { "$ref": "#/$defs/blockStep" },
        { "$ref": "#/$defs/lineStep" },
        { "$ref": "#/$defs/returnStep" },
        { "$ref": "#/$defs/controlStep" },
        { "$ref": "#/$defs/pluginStep" }
      ]
    },
    "cmdStep": {
      "type": "object",
      "required": ["cmd"],
      "additionalProperties": false,
      "properties": {
        "cmd": { "$ref": "#/$defs/stringOrArray" },
        "after": { "type": "string" },
        "when": { "type": "string" },
        "assert": { "$ref": "#/$defs/stringOrArray" },
        "ignore_error": { "type": "boolean", "default": false },
        "register": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "sleepStep": {
      "type": "object",
      "required": ["sleep"],
      "additionalProperties": false,
      "properties": {
        "sleep": { "$ref": "#/$defs/duration" }
      }
    },
    "callStep": {
      "type": "object",
      "required": ["call"],
      "additionalProperties": false,
      "properties": {
        "call": { "type": "string" },
        "after": { "type": "string" },
        "when": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "blockStep": {
      "type": "object",
      "required": ["block"],
      "additionalProperties": false,
      "properties": {
        "after": { "type": "string" },
        "when": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" },
        "block": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "prompts": {
              "type": "array",
              "items": { "$ref": "#/$defs/prompt" }
            },
            "enter": {
              "type": "array",
              "items": { "$ref": "#/$defs/step" }
            },
            "script": {
              "type": "array",
              "items": { "$ref": "#/$defs/step" }
            },
            "breakout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "script": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/step" }
                }
              }
            }
          }
        }
      }
    },
    "lineStep": {
      "type": "object",
      "required": ["line"],
      "additionalProperties": false,
      "properties": {
        "line": { "$ref": "#/$defs/stringOrArray" },
        "after": { "type": "string" },
        "when": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" }
      }
    },
    "returnStep": {
      "type": "object",
      "required": ["return"],
      "additionalProperties": false,
      "properties": {
        "return": { "type": "integer", "minimum": 1 },
        "after": { "type": "string" },
        "when": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" }
      }
    },
    "controlStep": {
      "type": "object",
      "required": ["control"],
      "additionalProperties": false,
      "properties": {
        "control": {
          "oneOf": [
            { "$ref": "#/$defs/controlChar" },
            { "type": "array", "items": { "$ref": "#/$defs/controlChar" } }
          ]
        },
        "after": { "type": "string" },
        "when": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "pluginStep": {
      "type": "object",
      "minProperties": 1,
      "allOf": [{ "$ref": "#/$defs/stepCommon" }],
      "not": {
        "anyOf": [
          { "required": ["cmd"] },
          { "required": ["sleep"] },
          { "required": ["call"] },
          { "required": ["block"] },
          { "required": ["line"] },
          { "required": ["return"] },
          { "required": ["control"] }
        ]
      }
    },
    "stepCommon": {
      "type": "object",
      "properties": {
        "after": { "type": "string" },
        "when": { "type": "string" },
        "delay_before": { "$ref": "#/$defs/duration" },
        "delay_after": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "sendEach": {
      "type": "object",
      "required": ["each"],
      "additionalProperties": false,
      "properties": {
        "each": { "type": "string", "pattern": "^vars(\\.[^.]+)+$" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fieldEntry" }
        }
      }
    },
    "fieldEntry": {
      "type": "object",
      "required": ["match", "field"],
      "additionalProperties": false,
      "properties": {
        "match": { "$ref": "#/$defs/regexes" },
        "field": { "type": "string" }
      }
    },
    "controlChar": {
      "type": "string",
      "maxLength": 1,
      "pattern": "[A-Za-z@`\\[{\\\\|\\]}^~_?]"
    },
    "duration": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(ms|s|m|h)$" }
      ]
    },
    "regexes": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "stringOrArray": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
